# Downloaded exporter binaries and their runtime state (not source).
bin/
run/
# Config generated by the native exporter path (paths are machine-specific).
native/
# Rendered dashboards — the directory Grafana provisions from, filled by
# `lesysbot dashboard render` or the start scripts. They describe one machine's
# sensors and one machine's installed packages, so they're never the same twice.
# The committed, portable dashboards one level up are the versioned ones.
grafana/dashboards/generated/
grafana/dashboards/generated-*.json
# Local overrides.
.env
