# Copy to `.env` (same folder) to override defaults. `.env` is git-ignored.
#
# Grafana admin login (change these before exposing Grafana anywhere).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# How long Prometheus keeps time series on disk.
PROM_RETENTION=15d

# Host ports, published on 127.0.0.1 only. If another program already has
# GRAFANA_PORT, start.sh moves Grafana to the next free port and saves it here.
# Change PROM_PORT yourself if 9090 is taken.
GRAFANA_PORT=3000
PROM_PORT=9090
