# Copy to `.env` (same folder) to override defaults. `.env` is git-ignored.
#
# Grafana admin login (change these before exposing Grafana anywhere).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# How long Prometheus keeps time series on disk.
PROM_RETENTION=15d

# Host ports (change if 3000 / 9090 are already taken on your machine).
# Both are published on 127.0.0.1 only.
GRAFANA_PORT=3000
PROM_PORT=9090
